# --- Database (docker-compose defaults) ---
DATABASE_URL=postgres://quorum:quorum@localhost:5432/quorum

# --- Redis (BullMQ queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# OAuth providers are optional in dev; the provider is skipped when unset.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Magic-link email via Resend (optional in dev)
AUTH_RESEND_KEY=
EMAIL_FROM=quorum@example.com

# --- Agent credential encryption (AES-256-GCM) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Realtime (Hocuspocus) ---
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Internal HTTP API between worker/web and ws. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
