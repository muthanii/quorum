# --- Database (docker-compose defaults) ---
DATABASE_URL=postgres://quorum:quorum@localhost:5432/quorum

# --- Redis (BullMQ queue + API rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# OAuth providers are optional in dev; the provider is skipped when unset.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Magic-link email via Resend (optional in dev)
AUTH_RESEND_KEY=
EMAIL_FROM=quorum@example.com

# --- Agent credential encryption (AES-256-GCM) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Realtime (Hocuspocus) ---
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Internal HTTP API between worker/web and ws. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# Where the worker reaches that internal API. Leave blank locally (both run on
# this machine); in production the worker and ws are separate hosts, so set it
# or agent turns run and then silently fail to post their results back.
WS_INTERNAL_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Rate limiting ---
# Per-bucket ceilings per 60s, as RATE_LIMIT_<BUCKET>. Leave unset in
# production: the shipped defaults (boards.create = 10/min) assume a proxy that
# sets x-forwarded-for, so every abuser gets their own bucket.
#
# Locally there is no such header, so ALL callers share one bucket — and
# `pnpm test:e2e` self-seeds a board per spec across 4 workers, which blows a
# 10/min budget and fails with 429. This raises the local ceiling so the suite
# can run; the limiter still applies, just far above one developer's pace.
RATE_LIMIT_BOARDS_CREATE=200
