{
  "mcpServers": {
    "webclaw": {
      "command": "/home/muthanii/.local/node/bin/npx",
      "args": ["-y", "@webclaw/mcp"],
      "env": {
        "WEBCLAW_API_KEY": "${WEBCLAW_API_KEY:-}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "godot": {
      "command": "/home/muthanii/.local/node/bin/npx",
      "args": ["-y", "@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "${GODOT_PATH:-}"
      }
    }
  }
}
